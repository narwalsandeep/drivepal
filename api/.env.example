PORT=3000
NODE_ENV=development
DATABASE_URL=

# CORS: not `false` → reflect browser Origin (needed for Flutter web). Set `CORS_RELAXED=false` in real production.
CORS_RELAXED=true

# Runtime hardening
SECURITY_HEADERS_ENABLED=true
API_THROTTLE_TTL_SECONDS=60
API_THROTTLE_LIMIT=120

# Required for JWT
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Dev bootstrap can use sync. Shared/prod environments should set sync false
# and run pending migrations on API startup.
TYPEORM_SYNC=true
TYPEORM_MIGRATIONS_RUN=false

# Password reset links point here (Angular auth/reset-password)
FRONTEND_WEB_URL=http://localhost:4200

# libphonenumber default region — UK only for now
DEFAULT_PHONE_REGION=GB

# Outbound mail (same keys as repo root `.env.example`)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=
MAIL_NAME="DRIVEPAL Team"

# Staff web console (Angular): must match the user’s email (same account can be customer/driver in the app).
ADMIN_EMAIL=

# Stripe (required for wallet add/list/remove cards)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Fare model (all optional; defaults preserve distance-only pricing)
FARE_BASE_GBP=0
FARE_PER_KM_MULTIPLIER=1
FARE_PER_MINUTE_GBP=0
FARE_MIN_GBP=0
FARE_SCHEDULED_SURCHARGE_GBP=0
FARE_SURGE_MULTIPLIER=1
