# Copy to `.env`. Defaults match common dev ports; change a value if that port is already in use on your machine.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

API_PORT=3000
UI_PORT=4200

# Passed into the API container — use a long random value in any shared environment
JWT_SECRET=

# API CORS: not false → reflect browser Origin (Flutter web). Set false when locking down production.
CORS_RELAXED=true

# Password reset links in emails (Angular)
FRONTEND_WEB_URL=http://localhost:4200

# Dev bootstrap can use sync. Shared/prod environments should set sync false
# and run pending migrations on API startup.
TYPEORM_SYNC=true
TYPEORM_MIGRATIONS_RUN=false

# Default region for national phone numbers (GB = United Kingdom only for now)
DEFAULT_PHONE_REGION=GB

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=
MAIL_NAME="DRIVEPAL Team"
# MAIL_LOG_CHANNEL — not used: no references in api/src.
# MAIL_LOG_CHANNEL=
ADMIN_EMAIL=

# Stripe (wallet + booking payment cards)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Fare model (all optional; defaults preserve distance-only pricing)
FARE_BASE_GBP=0
FARE_PER_KM_MULTIPLIER=1
FARE_PER_MINUTE_GBP=0
FARE_MIN_GBP=0
FARE_SCHEDULED_SURCHARGE_GBP=0
FARE_SURGE_MULTIPLIER=1
